# ── Public ──────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Neon Postgres (Phase 5 — leads + future mutable inventory) ──────
# Preferred: provision via Vercel Marketplace after `vercel link`:
#
#   npx vercel login
#   npx vercel link
#   npx vercel integration add neon --yes --no-claim
#   npx vercel env pull --yes
#
# Or create a project at https://console.neon.tech and paste the pooled URL:
#
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
#
# Also accepted: POSTGRES_URL or NEON_DATABASE_URL
#
# If unset, lead capture writes to `.data/leads.jsonl` (gitignored) so
# /advertise and POST /api/leads still work for local + launch.

# ── Optional analytics / forms (later phases) ───────────────────────
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=expat.sg
